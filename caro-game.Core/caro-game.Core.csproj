<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure game logic (models + rules). No UI dependency, so it can be unit tested. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>caro_game.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The MSIX packaging project publishes the app per runtime (win-x64, ...) and passes
         that runtime down to this library, so restore must know these runtimes too. -->
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
