<?xml version="1.0" encoding="utf-8"?>
<!-- Shared colours and styles of the game, merged into App.xaml. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CaroPlayerXBrush" Color="#D13438" />
            <SolidColorBrush x:Key="CaroPlayerOBrush" Color="#0063B1" />
            <SolidColorBrush x:Key="CaroBoardBackgroundBrush" Color="#FFFBF2" />
            <SolidColorBrush x:Key="CaroBoardLineBrush" Color="#D8CCB4" />
            <SolidColorBrush x:Key="CaroLastMoveBrush" Color="#FFEFD1" />
            <SolidColorBrush x:Key="CaroWinningLineBrush" Color="#FFD54F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="CaroPlayerXBrush" Color="#FF7A7F" />
            <SolidColorBrush x:Key="CaroPlayerOBrush" Color="#60CDFF" />
            <SolidColorBrush x:Key="CaroBoardBackgroundBrush" Color="#2B2926" />
            <SolidColorBrush x:Key="CaroBoardLineBrush" Color="#4F4A42" />
            <SolidColorBrush x:Key="CaroLastMoveBrush" Color="#47402F" />
            <SolidColorBrush x:Key="CaroWinningLineBrush" Color="#7A6420" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <!-- High contrast: only system colours; X and O are told apart by their shape. -->
            <SolidColorBrush x:Key="CaroPlayerXBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CaroPlayerOBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CaroBoardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CaroBoardLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CaroLastMoveBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CaroWinningLineBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Fluent card: rounded corners, card background and stroke, spacing on the 4 epx grid. -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Big X / O letter used in the status and score areas. -->
    <Style x:Key="PlayerSymbolTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <!-- Board cell: a Button with a flat template.
         It has no "Disabled" look, so X and O keep their colours when the cell can no longer be played. -->
    <Style x:Key="CaroCellButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{ThemeResource CaroBoardLineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="RootGrid"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Border
                            x:Name="HoverOverlay"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            Opacity="0" />
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            FontSize="{TemplateBinding FontSize}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}" />

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOverlay.Opacity" Value="1" />
                                        <Setter Target="HoverOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
